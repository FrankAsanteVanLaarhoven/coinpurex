{
  "name": "coinpurex-enterprise-platform",
  "version": "2.0.0",
  "description": "CoinPurex (coinpurex.com) - State-of-the-art enterprise-grade decentralized exchange and multi-signature governance treasury platform.",
  "homepage": "https://coinpurex.com",
  "main": "index.js",
  "scripts": {
    "test": "node test/run-all-tests.js",
    "test:contracts": "node test/run-all-tests.js",
    "test:gateway": "cd backend/go-gateway && go test -v ./...",
    "test:engine": "cd backend/rust-engine && cargo test",
    "test:all": "node test/run-all-tests.js && (cd backend/go-gateway && go test -v ./...) && (cd backend/rust-engine && cargo test)",
    "build:gateway": "cd backend/go-gateway && go build -o bin/go-gateway .",
    "build:engine": "cd backend/rust-engine && cargo build --release",
    "build": "npm run build:gateway && npm run build:engine && npm run deploy:local && npm run seed",
    "deploy:local": "node scripts/deploy.js --network localhost",
    "deploy:sepolia": "node scripts/deploy.js --network sepolia",
    "seed": "node scripts/seed.js",
    "start": "node scripts/server.js",
    "start:gateway": "cd backend/go-gateway && go run .",
    "start:engine": "cd backend/rust-engine && cargo run --release",
    "start:all": "node scripts/start-all.js"
  },
  "keywords": [
    "coinpurex",
    "coinpurex.com",
    "blockchain",
    "dex",
    "order-book",
    "multisig",
    "enterprise",
    "solidity",
    "ethereum"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FrankAsanteVanLaarhoven/coinpurex.git"
  },
  "author": "CoinPurex Institutional Web3 Engineering (coinpurex.com)",
  "license": "MIT"
}
